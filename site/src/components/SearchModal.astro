---
// site/src/components/SearchModal.astro
import { type Lang, t } from '@/lib/i18n';
import { langBase } from '@/lib/base';
import { LAWS, lawAbbr } from '@/lib/laws';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Abbreviation (any language, lower-cased, without dots) → [slug, display abbr]
// so "8 BV", "art. 8 Cst" or "BGFA 12" can jump straight to the article.
const jumpTable: Record<string, [string, string]> = {};
for (const law of LAWS) {
  for (const a of [law.abbr, ...Object.values(law.abbrI18n || {})]) {
    jumpTable[a!.toLowerCase().replace(/\./g, '')] = [law.slug, lawAbbr(law, lang)];
  }
}
---

<div class="search-overlay" id="search-overlay" aria-hidden="true">
  <div class="search-modal" role="dialog" aria-label={t('header.search', lang)}>
    <div class="search-input-wrapper">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        type="text"
        class="search-input"
        id="search-input"
        placeholder={t('search.placeholder', lang)}
        autocomplete="off"
      />
      <button type="button" class="search-close" aria-label={t('search.close', lang)}><kbd class="search-kbd">Esc</kbd></button>
    </div>
    <div
      class="search-results"
      id="search-results"
      data-no-results={t('search.no_results', lang)}
      data-dev-msg={t('search.dev_unavailable', lang)}
      data-goto={t('search.goto', lang)}
      data-base={langBase(lang)}
      data-jump={JSON.stringify(jumpTable)}
    >
      <!-- Results injected by JS -->
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    background: color-mix(in srgb, var(--color-bg, #fff) 80%, transparent);
    backdrop-filter: blur(4px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 15vh var(--space-3) var(--space-4);
  }

  .search-overlay.open {
    display: flex;
  }

  .search-modal {
    max-width: 640px;
    width: 100%;
    max-height: 70vh;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    font-size: 16px;
    font-family: var(--font-ui);
    color: var(--color-text);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-close {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .search-results {
    overflow-y: auto;
    max-height: calc(70vh - 60px);
    padding: var(--space-1);
  }

  :global(.search-result) {
    display: flex;
    align-items: start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    text-decoration: none;
    color: var(--color-text);
    transition: background var(--transition-fast);
  }

  :global(.search-result:hover),
  :global(.search-result.active) {
    background: var(--color-rule-light);
  }

  :global(.search-result-law) {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global(.search-result-content) {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
  }

  :global(.search-result-title) {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
  }

  :global(.search-result-excerpt) {
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: 2px;
    line-height: 1.4;
  }

  :global(.search-result-excerpt mark) {
    background: none;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    padding: 0;
  }

  :global(.search-empty) {
    text-align: center;
    padding: var(--space-4);
    color: var(--color-text-muted);
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding: var(--space-3);
      align-items: flex-start;
      padding-top: 10vh;
    }
    .search-modal {
      max-width: 100%;
      max-height: 80vh;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');
    if (!overlay || !input || !resultsContainer) return;

    let pagefind: any = null;
    let activeIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout>;

    // Load Pagefind lazily
    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        // Pagefind is generated after the build; keep the specifier opaque to
        // Vite so the dev server doesn't try (and fail) to resolve it.
        const pagefindUrl = `${document.querySelector('meta[name="base-url"]')?.getAttribute('content') || ''}/pagefind/pagefind.js`;
        pagefind = await import(/* @vite-ignore */ pagefindUrl);
        await pagefind.init();
        return pagefind;
      } catch {
        return null;
      }
    }

    function open() {
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      input.value = '';
      resultsContainer!.textContent = '';
      activeIndex = -1;
      setTimeout(() => input.focus(), 50);
      loadPagefind();
    }

    function close() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      input.blur();
    }

    overlay.querySelector('.search-close')?.addEventListener('click', close);

    // "Art. 8 BV", "8 BV", "BV 8", "art 12 bgfa", "Art. 8 Cst." → direct link
    const jump: Record<string, [string, string]> = JSON.parse(resultsContainer.dataset.jump || '{}');
    function parseArticleRef(q: string): { href: string; label: string } | null {
      const norm = q.trim().replace(/\./g, '').replace(/\s+/g, ' ').toLowerCase();
      let m = norm.match(/^(?:art )?(\d+[a-z]*) ([a-z]+)$/);
      let num: string | undefined, abbr: string | undefined;
      if (m) { num = m[1]; abbr = m[2]; }
      else if ((m = norm.match(/^([a-z]+) (?:art )?(\d+[a-z]*)$/))) { abbr = m[1]; num = m[2]; }
      if (!num || !abbr || !jump[abbr]) return null;
      const [slug, display] = jump[abbr];
      return {
        href: `${resultsContainer!.dataset.base}/${slug}/art-${parseInt(num, 10)}${num.replace(/^\d+/, '')}/`,
        label: `Art. ${num} ${display}`,
      };
    }

    // Keyboard shortcut: Cmd+K / Ctrl+K
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        overlay.classList.contains('open') ? close() : open();
      }
      if (e.key === 'Escape' && overlay.classList.contains('open')) {
        close();
      }
    });

    // Click outside to close
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // Search trigger buttons
    document.querySelectorAll('.search-trigger').forEach(btn => {
      btn.addEventListener('click', open);
    });

    // Debounced search
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(input.value), 150);
    });

    // Arrow key navigation
    input.addEventListener('keydown', (e) => {
      const results = resultsContainer.querySelectorAll('.search-result');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, results.length - 1);
        updateActive(results);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, -1);
        updateActive(results);
      } else if (e.key === 'Enter' && results.length > 0) {
        e.preventDefault();
        (results[Math.max(activeIndex, 0)] as HTMLAnchorElement).click();
      }
    });

    function updateActive(results: NodeListOf<Element>) {
      results.forEach((r, i) => r.classList.toggle('active', i === activeIndex));
      if (activeIndex >= 0 && results[activeIndex]) {
        results[activeIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    function renderEmpty(message: string) {
      const div = document.createElement('div');
      div.className = 'search-empty';
      div.textContent = message;
      resultsContainer.textContent = '';
      resultsContainer.appendChild(div);
    }

    function renderJump(ref: { href: string; label: string }) {
      const a = document.createElement('a');
      a.href = ref.href;
      a.className = 'search-result search-result--jump';
      const tag = document.createElement('span');
      tag.className = 'search-result-law';
      tag.textContent = '→';
      const body = document.createElement('div');
      body.className = 'search-result-content';
      const title = document.createElement('div');
      title.className = 'search-result-title';
      title.textContent = `${resultsContainer!.dataset.goto || ''} ${ref.label}`.trim();
      body.appendChild(title);
      a.append(tag, body);
      resultsContainer!.appendChild(a);
    }

    function renderResults(loaded: any[]) {
      for (const result of loaded) {
        const url = result.url;
        const law = result.meta?.law || '';
        const title = result.meta?.title || '';
        const excerpt = result.excerpt || '';

        const a = document.createElement('a');
        a.href = url;
        a.className = 'search-result';

        if (law) {
          const lawSpan = document.createElement('span');
          lawSpan.className = 'search-result-law';
          lawSpan.textContent = law;
          a.appendChild(lawSpan);
        }

        const contentDiv = document.createElement('div');
        contentDiv.className = 'search-result-content';

        const titleDiv = document.createElement('div');
        titleDiv.className = 'search-result-title';
        titleDiv.textContent = title;
        contentDiv.appendChild(titleDiv);

        if (excerpt) {
          const excerptDiv = document.createElement('div');
          excerptDiv.className = 'search-result-excerpt';
          // Pagefind excerpts contain only <mark> tags which are safe
          excerptDiv.innerHTML = excerpt;
          contentDiv.appendChild(excerptDiv);
        }

        a.appendChild(contentDiv);
        resultsContainer.appendChild(a);
      }
    }

    async function performSearch(query: string) {
      if (!query.trim()) {
        resultsContainer.textContent = '';
        activeIndex = -1;
        return;
      }

      const ref = parseArticleRef(query);
      const pf = await loadPagefind();
      if (!pf) {
        resultsContainer.textContent = '';
        if (ref) renderJump(ref);
        else renderEmpty(resultsContainer.dataset.devMsg || 'Search unavailable');
        return;
      }

      const lang = document.documentElement.lang || 'de';
      const search = await pf.search(query, { filters: { language: lang } });
      // Load first 10 results
      const loaded = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));
      if (input!.value !== query) return; // a newer query is in flight

      resultsContainer.textContent = '';
      activeIndex = -1;
      if (ref) renderJump(ref);
      if (loaded.length === 0 && !ref) {
        renderEmpty(resultsContainer.dataset.noResults || 'No results');
        return;
      }
      renderResults(loaded);
    }
  });
</script>
