---
// site/src/components/BetaOverlay.astro
// Beta disclosure modal. Companion to the persistent .beta-bar in
// Header.astro — the bar is the always-visible thin reminder, this
// overlay is the prominent "set expectations" interrupt.
//
// Lifecycle:
//  - Shown once per visit (browser session) after a 200ms delay.
//  - Dismissible via button, Escape key, or backdrop click.
//  - Dismissal is remembered for the rest of the session, so returning to
//    the home page does not re-interrupt; a new visit shows it again. The
//    persistent .beta-bar keeps the disclosure visible on every page.
import { type Lang, t } from '@/lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div
  class="beta-overlay"
  id="beta-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="beta-overlay-title"
  aria-describedby="beta-overlay-body"
  hidden
>
  <div class="beta-overlay__backdrop" data-beta-dismiss></div>
  <div class="beta-overlay__panel" role="document">
    <div class="beta-overlay__tag">{t('overlay.tag', lang)}</div>
    <h2 class="beta-overlay__title" id="beta-overlay-title">
      {t('overlay.title', lang)}
    </h2>
    <div class="beta-overlay__body" id="beta-overlay-body">
      <p>{t('overlay.body1', lang)}</p>
      <p>{t('overlay.body2', lang)}</p>
      <p>{t('overlay.body3', lang)}</p>
    </div>
    <div class="beta-overlay__actions">
      <a class="beta-overlay__link" href="https://github.com/jonashertner/openlegalcommentary/issues" target="_blank" rel="noopener">GitHub &nearr;</a>
      <button
        type="button"
        class="beta-overlay__button"
        data-beta-dismiss
        autofocus
      >
        {t('overlay.button', lang)}
      </button>
    </div>
  </div>
</div>

<style>
  .beta-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4, 24px);
  }

  .beta-overlay[hidden] {
    display: none;
  }

  .beta-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  :global([data-theme='dark']) .beta-overlay__backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .beta-overlay__panel {
    position: relative;
    max-width: 540px;
    width: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-rule);
    padding: 32px 36px 28px;
    box-sizing: border-box;
  }

  .beta-overlay__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #DC2626;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid #DC2626;
  }

  .beta-overlay__title {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 18px 0;
    color: var(--color-text);
  }

  .beta-overlay__body {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-text);
  }

  .beta-overlay__body p {
    margin: 0 0 12px 0;
  }

  .beta-overlay__body p:last-child {
    margin-bottom: 0;
  }

  .beta-overlay__actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-rule-light);
  }

  .beta-overlay__link {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .beta-overlay__button {
    background: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
    padding: 10px 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1;
  }

  .beta-overlay__button:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .beta-overlay__button:focus-visible {
    outline: 2px solid #DC2626;
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .beta-overlay__panel {
      padding: 24px 24px 20px;
    }
    .beta-overlay__title {
      font-size: 19px;
    }
  }
</style>

<script>
  const SEEN_KEY = 'olc-beta-overlay-seen';

  function initBetaOverlay() {
    const overlay = document.getElementById('beta-overlay');
    if (!overlay) return;

    let seen = false;
    try { seen = sessionStorage.getItem(SEEN_KEY) === '1'; } catch { /* storage blocked */ }
    if (seen) return;

    const previousFocus = document.activeElement as HTMLElement | null;
    const timer = window.setTimeout(() => {
      overlay.removeAttribute('hidden');
      overlay.querySelector<HTMLButtonElement>('.beta-overlay__button')?.focus();
    }, 200);

    function dismiss() {
      window.clearTimeout(timer);
      overlay!.setAttribute('hidden', '');
      document.removeEventListener('keydown', onKey);
      try { sessionStorage.setItem(SEEN_KEY, '1'); } catch { /* storage blocked */ }
      previousFocus?.focus?.();
    }

    function onKey(event: KeyboardEvent) {
      if (event.key === 'Escape') dismiss();
    }

    overlay.querySelectorAll('[data-beta-dismiss]').forEach((el) => {
      el.addEventListener('click', dismiss);
    });
    document.addEventListener('keydown', onKey);
  }

  // Fires on the initial load and after every client-side navigation.
  document.addEventListener('astro:page-load', initBetaOverlay);
</script>
