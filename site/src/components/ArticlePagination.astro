---
// site/src/components/ArticlePagination.astro
import { type Lang, t } from '@/lib/i18n';
import { langBase } from '@/lib/base';

export interface Props {
  lang: Lang;
  law: string;
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
}

const { lang, law, prev, next } = Astro.props;
const artLabel = (slug: string) => `Art. ${slug.replace('art-', '')}`;
---

<nav class="article-pagination" aria-label={t('pagination.prev', lang) + ' / ' + t('pagination.next', lang)}>
  {prev ? (
    <a href={`${langBase(lang)}/${law}/${prev.slug}/`} rel="prev" class="pagination-link pagination-prev">
      <span class="pagination-direction">&larr; {t('pagination.prev', lang)}</span>
      <span class="pagination-title"><span class="pagination-num">{artLabel(prev.slug)}</span> {prev.title}</span>
    </a>
  ) : <span />}

  {next ? (
    <a href={`${langBase(lang)}/${law}/${next.slug}/`} rel="next" class="pagination-link pagination-next">
      <span class="pagination-direction">{t('pagination.next', lang)} &rarr;</span>
      <span class="pagination-title"><span class="pagination-num">{artLabel(next.slug)}</span> {next.title}</span>
    </a>
  ) : <span />}
</nav>

<style>
  .article-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    max-width: var(--content-width);
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    text-decoration: none;
    color: var(--color-text);
  }

  .pagination-next {
    text-align: right;
  }

  .pagination-direction {
    font-size: var(--text-2xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .pagination-title {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.35;
    color: var(--color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color var(--transition-fast);
  }

  .pagination-num {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 650;
    color: var(--color-text);
    margin-right: 4px;
  }

  .pagination-link:hover .pagination-title {
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .article-pagination {
      grid-template-columns: 1fr;
    }
    .pagination-next {
      text-align: left;
    }
  }
</style>
