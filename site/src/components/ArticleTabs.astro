---
// site/src/components/ArticleTabs.astro
import { type Lang, t } from '@/lib/i18n';

interface TocEntry {
  level: number;
  text: string;
  id: string;
}

interface Layer {
  id: 'summary' | 'doctrine' | 'caselaw';
  html: string;
  available: boolean;
  /** Shown in German because the translation is missing. */
  fallback?: boolean;
}

export interface Props {
  lang: Lang;
  layers: Layer[];
  doctrineToc?: TocEntry[];
  caselawToc?: TocEntry[];
}

const {
  lang,
  layers,
  doctrineToc = [],
  caselawToc = [],
} = Astro.props;

// Only offer layers that exist; open the first one, preferring a translated
// layer over a German fallback (the URL's ?layer= can still select another).
const shown = layers.filter((l) => l.available);
const activeTab = (shown.find((l) => !l.fallback) ?? shown[0])?.id ?? 'summary';
const tocs: Record<string, TocEntry[]> = { doctrine: doctrineToc, caselaw: caselawToc };
---

<div class="tabs-container" data-active-tab={activeTab}>
  <div class="tabs-nav" role="tablist" aria-label={shown.map((l) => t(`tab.${l.id}`, lang)).join(' / ')} data-pagefind-ignore>
    {shown.map((layer) => (
      <button
        type="button"
        role="tab"
        id={`tab-${layer.id}`}
        aria-controls={`panel-${layer.id}`}
        aria-selected={activeTab === layer.id ? 'true' : 'false'}
        tabindex={activeTab === layer.id ? 0 : -1}
        class:list={['tab-btn', { active: activeTab === layer.id }]}
        data-tab={layer.id}
      >
        {t(`tab.${layer.id}`, lang)}
      </button>
    ))}
  </div>

  {shown.map((layer) => {
    const toc = tocs[layer.id] || [];
    return (
      <div
        role="tabpanel"
        id={`panel-${layer.id}`}
        aria-labelledby={`tab-${layer.id}`}
        tabindex="0"
        class:list={['tab-panel', { hidden: activeTab !== layer.id, 'has-toc': toc.length > 2 }]}
        data-panel={layer.id}
        data-label={t(`tab.${layer.id}`, lang)}
      >
        {toc.length > 2 && (
          <nav class="toc" aria-label={t('article.toc', lang)} data-pagefind-ignore>
            <details open>
              <summary class="toc-toggle">{t('article.toc', lang)}</summary>
              <ol class="toc-list">
                {toc.map((entry) => (
                  <li class:list={[{ 'toc-sub': entry.level === 3 }]}>
                    <a href={`#${entry.id}`}>{entry.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )}
        <div class="panel-body prose" lang={layer.fallback ? 'de' : undefined}>
          {layer.fallback && (
            <p class="fallback-notice" lang={lang} data-pagefind-ignore>{t('article.fallback_notice', lang)}</p>
          )}
          <Fragment set:html={layer.html} />
        </div>
      </div>
    );
  })}
</div>

<style>
  .tabs-nav {
    display: flex;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
    max-width: var(--content-width);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tabs-nav::-webkit-scrollbar { display: none; }

  .tab-btn {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 0 0 12px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--color-text);
  }

  .tab-btn.active {
    color: var(--color-text);
    font-weight: 650;
    border-bottom-color: var(--color-text);
  }

  .tab-panel.hidden {
    display: none;
  }

  .tab-panel:focus-visible {
    outline-offset: 8px;
  }

  .fallback-notice {
    font-family: var(--font-ui);
    font-size: 12.5px !important;
    line-height: 1.5;
    color: var(--color-text-secondary);
    border-left: 2px solid var(--color-accent);
    padding: 2px 0 2px 12px;
    margin-bottom: var(--space-4) !important;
    hyphens: manual;
  }

  /* ── Table of contents ─────────────────────────────────────── */
  .toc {
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    max-width: var(--content-width);
  }

  .toc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-toggle::-webkit-details-marker { display: none; }

  .toc-toggle::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform var(--transition-fast);
  }

  details[open] > .toc-toggle::after {
    transform: rotate(-135deg) translateY(-1px);
  }

  .toc-list {
    list-style: none;
    padding: 0 var(--space-2) 12px;
    margin: 0;
  }

  .toc-list li a {
    display: block;
    padding: 4px 0;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .toc-list li a:hover,
  .toc-list li.toc-active a {
    color: var(--color-text);
  }

  .toc-list li.toc-active > a {
    font-weight: 600;
  }

  .toc-sub {
    padding-left: 1rem;
  }

  .toc-sub a {
    font-size: 12px !important;
  }

  /* ── Wide screens: contents in a sticky rail beside the text ── */
  @media (min-width: 1240px) {
    .tab-panel.has-toc:not(.hidden) {
      display: grid;
      grid-template-columns: minmax(0, var(--content-width)) minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: start;
    }

    .tab-panel.has-toc .panel-body {
      grid-column: 1;
      grid-row: 1;
    }

    .tab-panel.has-toc .toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h) + var(--space-3));
      max-height: calc(100vh - var(--header-h) - var(--space-5));
      overflow-y: auto;
      margin: 0;
      border: none;
      border-left: 1px solid var(--color-rule-light);
      max-width: 260px;
      scrollbar-width: thin;
    }

    .tab-panel.has-toc .toc-toggle {
      padding: 0 0 10px var(--space-2);
      cursor: default;
      pointer-events: none;
    }

    .tab-panel.has-toc .toc-toggle::after { display: none; }

    .tab-panel.has-toc .toc-list {
      padding: 0;
    }

    .tab-panel.has-toc .toc-list li a {
      padding: 4px 0 4px var(--space-2);
      margin-left: -1px;
      border-left: 1px solid transparent;
      font-size: 12.5px;
    }

    .tab-panel.has-toc .toc-sub a {
      padding-left: calc(var(--space-2) + 0.85rem) !important;
      font-size: 12px !important;
    }

    .tab-panel.has-toc .toc-sub {
      padding-left: 0;
    }

    .tab-panel.has-toc .toc-list li.toc-active > a {
      border-left-color: var(--color-text);
    }
  }

  @media (max-width: 768px) {
    .tabs-nav {
      gap: var(--space-3);
    }
    .tab-btn {
      padding-bottom: 12px;
      min-height: 40px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector('.tabs-container');
    if (!container) return;

    const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('.tab-btn'));
    const defaultTab = (container as HTMLElement).dataset.activeTab;
    const panels = container.querySelectorAll<HTMLElement>('.tab-panel');

    function switchTab(tabName: string, focus = false) {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.tab === tabName;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', String(isActive));
        btn.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) btn.focus();
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.panel !== tabName);
      });

      // Reflect the layer in the URL so it can be shared
      const url = new URL(window.location.href);
      if (tabName === defaultTab) {
        url.searchParams.delete('layer');
      } else {
        url.searchParams.set('layer', tabName);
      }
      history.replaceState(history.state, '', url.toString());
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.tab) switchTab(btn.dataset.tab);
      });
      // Arrow keys move between tabs (WAI-ARIA tabs pattern)
      btn.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % buttons.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + buttons.length) % buttons.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = buttons.length - 1;
        if (next >= 0) {
          e.preventDefault();
          const tab = buttons[next].dataset.tab;
          if (tab) switchTab(tab, true);
        }
      });
    });

    // Initial tab from ?layer=, or from a #n-12 / #heading link into a hidden panel
    const layer = new URLSearchParams(window.location.search).get('layer');
    if (layer && buttons.some((b) => b.dataset.tab === layer)) {
      switchTab(layer);
    }
    if (window.location.hash) {
      const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      const panel = target?.closest<HTMLElement>('.tab-panel');
      if (panel?.dataset.panel && panel.classList.contains('hidden')) {
        switchTab(panel.dataset.panel);
        target!.scrollIntoView();
      }
    }

    // TOC active section tracking
    const tocLinks = document.querySelectorAll('.toc-list li a');
    if (tocLinks.length === 0) return;
    const headings = Array.from(tocLinks)
      .map((a) => document.getElementById((a.getAttribute('href') || '').slice(1)))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          tocLinks.forEach((link) => {
            link.parentElement?.classList.toggle('toc-active', link.getAttribute('href') === `#${id}`);
          });
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));
  });
</script>
